<Project Sdk="Microsoft.NET.Sdk">
  <!-- The level builder, run outside Unity. The game's own sources are LINKED from Assets as they
       are — nothing is copied, so a change to the generator or the rating is a change here too.
       Build:  dotnet build Tools/LevelGen -c Release      (the exe lands in Library/LevelGen/build) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Library/LevelGen/build/</OutputPath>
    <NoWarn>CS0649;CS0169;CS0414;CS8632;CS0219;CS0168;CS1574;CS1587</NoWarn>
    <AssemblyName>LevelGen</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Common/LevelTarget.cs" />
    <Compile Include="../../Assets/Scripts/Common/GenerationGates.cs" />
    <Compile Include="../../Assets/Scripts/Common/SolveTracer.cs" />
    <Compile Include="../../Assets/Scripts/Common/TrickWeights.cs" />
    <Compile Include="../../Assets/Scripts/Common/TraceNode.cs" />
    <Compile Include="../../Assets/Scripts/Common/Hint.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/PoolBuilder.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/CampaignCurve.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/LevelColors.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/StencilFiller.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/LevelGenerator.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/SolutionPlacer.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/RegionGrower.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/QueensSolver.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/WeightRater.cs" />
    <Compile Include="../../Assets/Scripts/LevelBuilder/Editor/TimeRater.cs" />
  </ItemGroup>
</Project>
